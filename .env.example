# Copy to .env.local for local development, or set these in your host's
# dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# Public address of the shop, without a trailing slash. Used in emails and SEO.
SITE_URL=https://www.example.cz

# Where new orders and inquiries are announced.
OWNER_EMAIL=objednavky@example.cz

# Sender of all emails. The domain must be verified in Resend.
EMAIL_FROM="Ocel & Laser <obchod@example.cz>"

# API key from https://resend.com (free tier is enough). Without it, emails
# are only printed to the server log.
RESEND_API_KEY=

# Bank account for payments by transfer (shown on the confirmation page and
# encoded in the QR payment code).
BANK_IBAN=CZ6508000000192000145399
BANK_ACCOUNT=19-2000145399/0800
BANK_RECIPIENT="Ocel & Laser"

# Days the customer has to pay (default 7).
PAYMENT_DUE_DAYS=7

# Database. A local SQLite file works on a VPS or for development. On
# serverless hosts (Vercel) create a free Turso database and use its URL:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:data/shop.db
DATABASE_AUTH_TOKEN=
